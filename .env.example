# DocuMind Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=production
PORT=5000

# Storage
DATABASE_URL=sqlite:///instance/documind.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432  # 32 MB max request size
MAX_PAGES_PER_DOC=50
MAX_DOCUMENTS_PER_AUDIT=10

# OCR Settings
TESSERACT_CMD=tesseract  # Path to tesseract binary if not in PATH
ENABLE_OCR=true

# Optional LLM Enhancement (Deterministic pipeline works 100% without this)
LLM_PROVIDER=gemini  # options: gemini, groq, none
LLM_API_KEY=
LLM_MODEL=

# AI Fact Checker (Free Tier Services)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite
FACTCHECK_API_KEY=your_google_factcheck_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
FACTCHECK_MAX_CLAIMS=12
