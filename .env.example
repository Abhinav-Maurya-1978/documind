# DocuMind Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=production
PORT=5000

# Storage
DATABASE_URL=sqlite:///instance/documind.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432  # 32 MB max request size
MAX_PAGES_PER_DOC=50
MAX_DOCUMENTS_PER_AUDIT=10

# OCR Settings
TESSERACT_CMD=tesseract  # Path to tesseract binary if not in PATH
ENABLE_OCR=true

# Optional LLM Enhancement (Deterministic pipeline works 100% without this)
LLM_PROVIDER=none  # options: none, gemini, openai
LLM_API_KEY=
LLM_MODEL=
